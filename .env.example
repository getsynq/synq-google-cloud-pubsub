# SYNQ API Credentials (required)
# Get these from your SYNQ account
SYNQ_CLIENT_ID=your_client_id_here
SYNQ_CLIENT_SECRET=your_client_secret_here

# GCP Project ID (optional if running on GCP or gcloud is configured)
# Can be auto-detected from:
#   - GOOGLE_CLOUD_PROJECT env var
#   - GCP metadata server (when running on GCP)
#   - config.yaml
GCP_PROJECT_ID=your-gcp-project-id
